<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="@dimen/screen_padding"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_back"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/ByeDPI.Text.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/settings_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingVertical="8dp">

            <!-- Network card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/ByeDPI.Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="@string/section_network" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_port"
                    style="@style/Widget.ByeDPI.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_port"
                    app:helperText="@string/helper_port">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_port"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLength="5" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_dns"
                    style="@style/Widget.ByeDPI.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/hint_dns"
                    app:helperText="@string/helper_dns">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_dns"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:digits="0123456789abcdefABCDEF.:"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:maxLength="45" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_udp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:text="@string/switch_udp"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_ipv6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/switch_ipv6"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Strategy card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/ByeDPI.Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/section_strategy" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_custom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/switch_custom"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <!-- Structured options -->
                <LinearLayout
                    android:id="@+id/group_structured"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_method"
                        style="@style/Widget.ByeDPI.TextInput.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_method">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/dd_method"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_position"
                        style="@style/Widget.ByeDPI.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/hint_position"
                        app:helperText="@string/helper_position">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_position"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789+-:shnem"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:maxLength="16" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_fake_ttl"
                        style="@style/Widget.ByeDPI.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/hint_fake_ttl"
                        app:helperText="@string/helper_fake_ttl">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_fake_ttl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:maxLength="3" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_tlsrec"
                        style="@style/Widget.ByeDPI.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/hint_tlsrec"
                        app:helperText="@string/helper_tlsrec">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_tlsrec"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789+-:shnem"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:maxLength="16" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_auto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:text="@string/switch_auto"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_timeout"
                        style="@style/Widget.ByeDPI.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:hint="@string/hint_timeout"
                        app:helperText="@string/helper_timeout">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_timeout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="numberDecimal"
                            android:maxLength="5" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Custom arguments -->
                <LinearLayout
                    android:id="@+id/group_custom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_custom_args"
                        style="@style/Widget.ByeDPI.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_custom_args"
                        app:helperText="@string/helper_custom_args">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_custom_args"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:inputType="textMultiLine|textNoSuggestions"
                            android:minLines="3"
                            android:typeface="monospace" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Preview card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:layout_marginBottom="@dimen/card_gap"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/ByeDPI.Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_preview" />

                <TextView
                    android:id="@+id/tv_args_preview"
                    style="@style/ByeDPI.Text.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/value_none"
                    android:textIsSelectable="true" />

                <TextView
                    style="@style/ByeDPI.Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/preview_note"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_black"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset"
            style="@style/Widget.ByeDPI.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:text="@string/action_reset" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            style="@style/Widget.ByeDPI.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1.4"
            android:text="@string/action_save" />
    </LinearLayout>
</LinearLayout>
